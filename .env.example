# Copy this file to .env and replace both values before starting the server.
ADMIN_PASSWORD=
SESSION_SECRET=
PORT=3000
NODE_ENV=development
MAX_VIDEO_SIZE_MB=2048
# Set FRONTEND_ORIGIN to the exact public Netlify origin in production.
FRONTEND_ORIGIN=
# Cloudflare R2 S3 API credentials (production media storage).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# For Render, set DATA_DIR=/var/data and UPLOAD_DIR=/tmp/tazama-uploads.
DATA_DIR=
UPLOAD_DIR=
